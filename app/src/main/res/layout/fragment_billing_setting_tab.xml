<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    tools:context=".Fragments.BillingSettingTabFragment">

    <TextView
        android:id="@+id/billingTitleTV"
        android:layout_width="99dp"
        android:layout_height="44dp"
        android:text="Billing"
        android:textAllCaps="false"
        android:textSize="20sp"
        android:textStyle="bold"
        android:typeface="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.054"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.036" />

    <ImageButton
        android:id="@+id/backBttnIF"
        android:layout_width="37dp"
        android:layout_height="26dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_edit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.943"
        app:layout_constraintStart_toEndOf="@+id/billingTitleTV"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.034"
        tools:ignore="SpeakableTextPresentCheck" />

    <EditText
        android:id="@+id/LNeditText"
        android:layout_width="143dp"
        android:layout_height="40dp"
        android:layout_marginTop="68dp"
        android:background="@drawable/shape_edittext01"
        android:ems="10"
        android:hint="@string/last_name_hint"
        android:inputType="text"
        android:singleLine="false"
        android:textAlignment="center"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.12"
        app:layout_constraintStart_toEndOf="@+id/FNeditText"
        app:layout_constraintTop_toBottomOf="@+id/billingTitleTV"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="TouchTargetSizeCheck" />

    <EditText
        android:id="@+id/FNeditText"
        android:layout_width="143dp"
        android:layout_height="40dp"
        android:layout_marginTop="68dp"
        android:background="@drawable/shape_edittext01"
        android:ems="10"
        android:hint="@string/first_name_hint"
        android:inputType="text"
        android:textAlignment="center"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.042"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/billingTitleTV"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="TouchTargetSizeCheck" />

    <EditText
        android:id="@+id/PCeditText"
        android:layout_width="107dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/shape_edittext01"
        android:ems="10"
        android:hint="Postal Code"
        android:inputType="textPostalAddress"
        android:textAlignment="center"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.097"
        app:layout_constraintStart_toEndOf="@+id/countrySpinner"
        app:layout_constraintTop_toBottomOf="@+id/LNeditText"
        app:layout_constraintVertical_bias="0.01"
        tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />

    <Spinner
        android:id="@+id/countrySpinner"
        android:layout_width="146dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/shape_edittext01"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.033"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/FNeditText"
        app:layout_constraintVertical_bias="0.011"
        tools:ignore="TouchTargetSizeCheck" />

    <EditText
        android:id="@+id/SReditText"
        android:layout_width="132dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="19dp"
        android:background="@drawable/shape_edittext01"
        android:ems="10"
        android:hint="State/Region"
        android:inputType="textPostalAddress"
        android:textAlignment="center"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.21"
        app:layout_constraintStart_toEndOf="@+id/PCeditText"
        app:layout_constraintTop_toBottomOf="@+id/LNeditText"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/CITYeditText"
        android:layout_width="107dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/shape_edittext01"
        android:ems="10"
        android:hint="City"
        android:inputType="textPostalAddress"
        android:textAlignment="center"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.029"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/countrySpinner"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/MAeditText"
        android:layout_width="296dp"
        android:layout_height="41dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/shape_edittext01"
        android:ems="10"
        android:hint="Mailing Address"
        android:inputType="textPostalAddress"
        android:textAlignment="center"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/CITYeditText"
        app:layout_constraintTop_toBottomOf="@+id/PCeditText"
        app:layout_constraintVertical_bias="0.012"
        tools:ignore="TouchTargetSizeCheck" />

    <Button
        android:id="@+id/saveBttn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/themecolor"
        android:enabled="true"
        android:text="Save Billing Info"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.505"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/PCeditText"
        app:layout_constraintVertical_bias="0.187" />

</androidx.constraintlayout.widget.ConstraintLayout>